environment                 = "prod"
region                      = "eu-central-1"
control_plane_url           = "https://cloud.example.com"
control_plane_version       = "latest"
control_plane_install_url   = "https://releases.example.com/cloudcontrold/latest/cloudcontrold-linux-amd64"
