# Carbon Cloud credentials — copy to `.env` and fill in. All values below are
# obvious placeholders, never real secrets. A missing key only disables the
# capability that needs it; the control plane boots without any of these
# (see ADR 0006). Placeholder-looking values are treated as absent.

# --- clerk capability (session auth + membership sync) ---
# Clerk dashboard -> API Keys -> Publishable/secret key issuer (https://<instance>.clerk.accounts.dev).
# Unlocks: clerk
CARBONCLOUD_CLERK_ISSUER=CHANGEME
# Clerk dashboard -> Webhooks -> signing secret. Unlocks: clerk webhook verification
CARBONCLOUD_CLERK_WEBHOOK_SECRET=CHANGEME
# Clerk dashboard -> API Keys -> Secret key (sk_live_...). Unlocks: clerk backend API calls
CARBONCLOUD_CLERK_SECRET_KEY=CHANGEME
# Derived from the issuer by default; set only to override. Unlocks: clerk (alternate JWKS location)
CARBONCLOUD_CLERK_JWKS_URL=CHANGEME

# --- database ---
# Postgres DSN for shared deployments (sqlite needs no key). Unlocks: postgres storage backend
CARBONCLOUD_DATABASE_URL=CHANGEME

# --- node.identity capability (issue node certificates, sign join tokens) ---
# Generated locally: `cloudctl pki init`. Unlocks: node.identity
CARBONCLOUD_NODE_CA_KEY=CHANGEME
# Generated locally: `cloudctl pki init`. Unlocks: node.identity
CARBONCLOUD_NODE_CA_CERT=CHANGEME
# Generated locally: `openssl rand -hex 32`. Unlocks: node.identity
CARBONCLOUD_NODE_JOIN_TOKEN_SECRET=CHANGEME

# --- tenant.credentials capability (envelope encryption for tenant provider creds) ---
# Generated locally: `openssl rand -hex 32`. Unlocks: tenant.credentials
CARBONCLOUD_CRYPTO_ENVELOPE_MASTER_KEY=CHANGEME

# --- state.backend capability (remote Terraform state in S3) ---
# S3-compatible endpoint (MinIO/Garagen/R2); empty means AWS. Used by: state.backend
CARBONCLOUD_STATE_S3_ENDPOINT=CHANGEME
# Bucket holding Terraform state. Unlocks: state.backend
CARBONCLOUD_STATE_S3_BUCKET=CHANGEME
# Access key for the state bucket. Unlocks: state.backend
CARBONCLOUD_STATE_S3_ACCESS_KEY_ID=CHANGEME
# Secret key for the state bucket. Unlocks: state.backend
CARBONCLOUD_STATE_S3_SECRET_ACCESS_KEY=CHANGEME

# --- provisioning capability (managed nodes on your own hosts / clouds) ---
# SSH private key for generic BYO/managed hosts. Unlocks: provisioning
CARBONCLOUD_PROVIDER_GENERIC_SSH_PRIVATE_KEY=CHANGEME
# Hetzner Cloud console -> Security -> API tokens. Unlocks: per-tenant hetzner provisioning
CARBONCLOUD_PROVIDER_HETZNER_TOKEN=CHANGEME
# AWS IAM -> access key id. Unlocks: per-tenant aws provisioning
CARBONCLOUD_PROVIDER_AWS_ACCESS_KEY_ID=CHANGEME
# AWS IAM -> secret access key. Unlocks: per-tenant aws provisioning
CARBONCLOUD_PROVIDER_AWS_SECRET_ACCESS_KEY=CHANGEME
# GCP console -> IAM -> service account JSON. Unlocks: per-tenant gcp provisioning
CARBONCLOUD_PROVIDER_GCP_CREDENTIALS_JSON=CHANGEME
# DigitalOcean control panel -> API tokens. Unlocks: per-tenant digitalocean provisioning
CARBONCLOUD_PROVIDER_DIGITALOCEAN_TOKEN=CHANGEME
# Proxmox datacenter -> API tokens. Unlocks: per-tenant proxmox provisioning
CARBONCLOUD_PROVIDER_PROXMOX_TOKEN=CHANGEME
# Proxmox API endpoint, e.g. https://pve.example:8006. Used by: per-tenant proxmox provisioning
CARBONCLOUD_PROVIDER_PROXMOX_ENDPOINT=CHANGEME

# --- email capability (invitations + alerts) ---
# SMTP relay URL, e.g. smtp://user:pass@mail.example:587. Unlocks: email
CARBONCLOUD_SMTP_URL=CHANGEME
