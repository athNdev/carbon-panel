# Carbon Cloud local stack — copy to `.env` and adjust. Every credential here
# is an obvious fake for local dev only. Real deployments inject secrets via
# environment or an external secret manager; nothing secret is baked into images.
#
# Control-plane capability keys (all optional at boot; a missing key only
# disables its capability, see ADR 0006 and cloud/deploy/docker/.env.example):
#   CARBONCLOUD_CLERK_ISSUER, CARBONCLOUD_CLERK_WEBHOOK_SECRET,
#   CARBONCLOUD_CLERK_SECRET_KEY, CARBONCLOUD_DATABASE_URL,
#   CARBONCLOUD_NODE_JOIN_TOKEN_SECRET, CARBONCLOUD_CRYPTO_ENVELOPE_MASTER_KEY

# --- postgres (compose-local only) ---
POSTGRES_USER=carbon
POSTGRES_PASSWORD=changeme-fake-local-only
POSTGRES_DB=carboncloud

# --- control plane ---
# Postgres DSN assembled from the fakes above; override for an external DB.
CARBONCLOUD_DATABASE_URL=postgres://carbon:changeme-fake-local-only@postgres:5432/carboncloud?sslmode=disable
CARBONCLOUD_CLERK_ISSUER=CHANGEME
CARBONCLOUD_CLERK_WEBHOOK_SECRET=CHANGEME
CARBONCLOUD_NODE_JOIN_TOKEN_SECRET=CHANGEME-fake-local-only

# --- node agent ---
CLOUD_CONTROL_PLANE_URL=http://controld:8080
CLOUD_JOIN_TOKEN=CHANGEME-fake-local-only

# --- console ---
PUBLIC_API_URL=http://localhost:8080
