FROM golang:alpine AS builder

WORKDIR /build

# Copy go mod files first for caching
COPY go.mod go.sum ./
RUN for i in 1 2 3 4 5; do go mod download && exit 0; echo "go mod download failed (attempt $i), retrying"; sleep $((i*5)); done; exit 1

# Copy source code
COPY cmd/status/ ./cmd/status/
COPY pkg/proto/ ./pkg/proto/

# Build the binary
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /status-panel ./cmd/status

FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /status-panel /usr/local/bin/status-panel

ENTRYPOINT ["/usr/local/bin/status-panel"]
