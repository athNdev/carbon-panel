ARG APP_VERSION=dev

# Generate protobuf code using buf
FROM bufbuild/buf:latest AS proto-builder
WORKDIR /app
COPY buf.yaml buf.gen.yaml buf.lock ./
COPY proto/ ./proto/
RUN mkdir -p web/mineserver/static pkg/proto web/mineserver/src/lib/proto && buf generate

FROM oven/bun:1-alpine AS frontend-builder

ARG APP_VERSION
ENV APP_VERSION=${APP_VERSION}

WORKDIR /app/web/mineserver

COPY web/mineserver/package.json web/mineserver/bun.lock ./
RUN bun install --frozen-lockfile

COPY web/mineserver/ ./
COPY --from=proto-builder /app/web/mineserver/src/lib/proto ./src/lib/proto/
COPY --from=proto-builder /app/web/mineserver/static/schemav1.yaml ./static/

RUN bun run build

FROM golang:alpine AS backend-builder

ARG APP_VERSION
ENV APP_VERSION=${APP_VERSION}

RUN apk add --no-cache gcc musl-dev sqlite-dev

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=proto-builder /app/pkg/proto ./pkg/proto/
COPY --from=frontend-builder /app/web/mineserver/build ./web/mineserver/build

RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo -o mineserver ./cmd/mineserver

FROM alpine:latest

ARG APP_VERSION
ENV APP_VERSION=${APP_VERSION}

RUN apk --no-cache add ca-certificates sqlite-libs

WORKDIR /app

COPY --from=backend-builder /app/mineserver .
COPY config.example.yaml ./

#RUN mkdir -p data/servers backups tmp

EXPOSE 8080

CMD ["./mineserver"]