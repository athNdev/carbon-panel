{
  "name": "mineserver",
  "version": "1.0.0",
  "private": true,
  "description": "MineServer development workspace",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:backend": "air",
    "dev:frontend": "cd web/mineserver && bun run dev",
    "build": "make build",
    "check": "cd web/mineserver && bun run check",
    "lint": "cd web/mineserver && bun run lint",
    "format": "cd web/mineserver && bun run format",
    "test": "go test ./internal/packwiz/... ./internal/scheduler/... ./internal/snapshot/... ./internal/docker/..."
  }
}
