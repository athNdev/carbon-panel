{
  "name": "carbon-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Carbon Panel development workspace",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:backend": "air",
    "dev:frontend": "cd web/carbon-panel && bun run dev",
    "build": "make build",
    "check": "cd web/carbon-panel && bun run check",
    "lint": "cd web/carbon-panel && bun run lint",
    "format": "cd web/carbon-panel && bun run format",
    "test": "make test",
    "test:frontend": "cd web/carbon-panel && bun run test"
  }
}
