---
const docsBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const websiteBase = process.env.WEBSITE_BASE_PATH || '/carbonpanel/';
---
<div class="brand-navigation">
  <a class="brand-home" href={websiteBase} aria-label="Carbon Panel website">
    <img class="dark-logo" src={docsBase + 'brand-mark-light.svg'} width="28" height="28" alt="" />
    <img class="light-logo" src={docsBase + 'brand-mark-dark.svg'} width="28" height="28" alt="" />
    <span>CARBON PANEL</span>
  </a>
  <span class="brand-separator" aria-hidden="true">/</span>
  <a class="docs-home" href={docsBase}>Docs</a>
</div>
<style>
  .brand-navigation { display:flex; align-items:center; gap:14px; white-space:nowrap; }
  a { display:inline-flex; align-items:center; gap:10px; color:var(--sl-color-white); text-decoration:none; }
  .brand-home span { font-size:12px; font-weight:600; letter-spacing:.035em; }
  .brand-separator { color:var(--sl-color-gray-3); }
  .docs-home { font-size:14px; }
  .light-logo { display:none; }
  :global([data-theme="light"]) .dark-logo { display:none; }
  :global([data-theme="light"]) .light-logo { display:block; }
  @media(max-width:400px) { .brand-home span { display:none; } .brand-navigation { gap:10px; } }
</style>
