---
import version from '../../../website-source.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<div class="version-banner" data-pagefind-ignore>
  <span>{import.meta.env.DEV ? 'Working-tree preview' : version.label}</span>
  <a href={base + 'versions/'}>Pinned to {version.revision.slice(0, 7)} <span aria-hidden="true">↗</span></a>
</div>
<style>
  .version-banner { display:flex; justify-content:center; flex-wrap:wrap; gap:8px 18px; padding:9px 20px; background:var(--sl-color-gray-6); color:var(--sl-color-gray-2); font-size:12px; border-bottom:1px solid var(--sl-color-gray-5); }
  a { color:var(--sl-color-white); text-underline-offset:3px; }
</style>
